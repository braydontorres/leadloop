# Browser-safe Supabase credentials only. Never put service-role or OpenAI keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Public HTTPS base URL for the trusted Next.js API. This is required for
# iPhone transcription; it must be reachable from the phone, not localhost.
EXPO_PUBLIC_LEADLOOP_VOICE_API_URL=https://leadloop-api.example.com
# Existing projects may use this name instead:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
