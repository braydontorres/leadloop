# Keep this value server-side. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Runtime-only Supabase settings for server API routes, including the
# authenticated mobile voice endpoint. These names avoid Next.js build-time
# replacement of NEXT_PUBLIC_* values. Use one key name, not both.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Browser-safe Supabase project settings for the optional cloud foundation.
# These are public/anon values only. Never expose SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase projects provide a publishable key. The app also supports
# NEXT_PUBLIC_SUPABASE_ANON_KEY for legacy projects; configure one, not both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
